# LuxWrap Studio - Variables sensibles del servidor
# Copia este archivo como .env en el hosting y completa los valores reales.
# IMPORTANTE: .env NO debe subirse a GitHub.

WEB3FORMS_ACCESS_KEY=pon_aqui_tu_access_key_de_web3forms
DEPLOY_SECRET=pon_aqui_un_secreto_largo_para_el_boton_de_actualizacion
SITE_PATH=/www/luxwrapstudio.com
GIT_BRANCH=main
GITHUB_ZIP_URL=https://github.com/beto2l/luxwrapstudio/archive/refs/heads/main.zip
CONTACT_EMAIL=luxwrapstudioky@gmail.com
SITE_NAME=LuxWrap Studio
SITE_URL=https://luxwrapstudio.com

# Opcional: si cambias el acceso admin, guarda aquí el hash bcrypt.
# ADMIN_PASSWORD_HASH=
